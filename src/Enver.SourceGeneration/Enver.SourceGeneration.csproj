<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../build/Library.props" />

  <PropertyGroup>
    <PackageId>Gnar.Enver.SourceGeneration</PackageId>
    <Description>Source generator and attributes for binding .env values to strongly-typed config classes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Enver/Enver.csproj" />
    <ProjectReference
      Include="../Enver.SourceGeneration.Generator/Enver.SourceGeneration.Generator.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
    />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <_GeneratorAssemblyPath>$(ArtifactsPath)/bin/Enver.SourceGeneration.Generator/$(Configuration.ToLowerInvariant())_netstandard2.0/Enver.SourceGeneration.Generator.dll</_GeneratorAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <None
      Include="$(_GeneratorAssemblyPath)"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
  </ItemGroup>
</Project>
