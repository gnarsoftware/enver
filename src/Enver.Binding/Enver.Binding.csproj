<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../build/Library.props" />

  <PropertyGroup>
    <PackageId>Gnar.Enver.Binding</PackageId>
    <Description>Source generator and attributes for binding .env values to strongly-typed config classes.</Description>
    <PackageTags>$(PackageTags);binding;source-generator;aot;trimming</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Enver/Enver.csproj" />
    <ProjectReference
      Include="../Enver.Binding.Generator/Enver.Binding.Generator.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
    />
    <ProjectReference
      Include="../Enver.Binding.Generator.Roslyn5.12/Enver.Binding.Generator.Roslyn5.12.csproj"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
    />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    One generator build per supported Roslyn version. The SDK picks the newest
    roslyn{X.Y} folder its compiler supports: the 5.0 build serves every .NET 10 SDK,
    the 5.12 build (.NET 11 SDK) adds polymorphic binding for closed types and
    unions. Do not also pack an unversioned analyzers/dotnet/cs copy, or both
    builds would load.
  -->
  <PropertyGroup>
    <_GeneratorOutputSuffix>$(Configuration.ToLowerInvariant())_netstandard2.0/Enver.Binding.Generator.dll</_GeneratorOutputSuffix>
  </PropertyGroup>
  <ItemGroup>
    <None
      Include="$(ArtifactsPath)/bin/Enver.Binding.Generator/$(_GeneratorOutputSuffix)"
      Pack="true"
      PackagePath="analyzers/dotnet/roslyn5.0/cs"
      Visible="false"
    />
    <None
      Include="$(ArtifactsPath)/bin/Enver.Binding.Generator.Roslyn5.12/$(_GeneratorOutputSuffix)"
      Pack="true"
      PackagePath="analyzers/dotnet/roslyn5.12/cs"
      Visible="false"
    />
  </ItemGroup>
</Project>
