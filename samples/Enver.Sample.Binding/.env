# Application
APP_NAME=My App
APP_ENV=development
APP_DEBUG=false

# Database
# DbConfig.Host reads DB_HOST, falling back to DB_SERVER, then PGHOST.
# Uncomment DB_HOST to see it take precedence.
# DB_HOST=primary.example.com
PGHOST=db.example.com
DB_PORT=5432
DB_NAME=myapp

# Database connection pool (DbConfig.Pool subsection)
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# External API
API_URL=https://api.example.com/v1
API_TIMEOUT_SECONDS=30
API_MAX_RETRIES=3

# Storage
STORAGE_TYPE=local # any of: local, remote, LOCAL, REMOTE
STORAGE_PATH=./storage # ignored with remote
STORAGE_BUCKET=bucket1 # ignored with local
STORAGE_REGION=region1 # ignored with local
