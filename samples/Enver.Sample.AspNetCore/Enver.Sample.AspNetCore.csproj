<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!--
      C# Dev Kit's project cache adds every analyzer in the ASP.NET Core targeting
      pack, including the request delegate generator that the SDK otherwise leaves
      off. Its interceptors then fail (CS9137) until the design-time build replaces
      the cached state. Enabling it explicitly keeps both states the same.
    -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Gnar.Enver.Extensions metapackage: .env configuration + options binding. -->
    <ProjectReference Include="../../src/Enver.Extensions/Enver.Extensions.csproj" />
    <!--
      Referenced directly rather than via the package, so pick the generator
      build explicitly (the package does this automatically).
    -->
    <ProjectReference
      Include="../../src/Enver.Binding.Generator.Roslyn5.12/Enver.Binding.Generator.Roslyn5.12.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <ItemGroup>
    <None Update=".env;.env.development" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
