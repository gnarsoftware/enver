# Application
APP_NAME=My App
APP_ENV=development
APP_DEBUG=false

# Database
DB_HOST=db.example.com
DB_PORT=5432
DB_NAME=myapp

# Database connection pool (DbConfig.Pool subsection)
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# External API
API_URL=https://api.example.com/v1
API_TIMEOUT_SECONDS=30
API_MAX_RETRIES=3
